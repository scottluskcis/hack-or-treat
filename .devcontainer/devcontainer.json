{
  "name": "Hack or Treat",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22.22.1"
    }
  },
  "postCreateCommand": "corepack enable && corepack prepare pnpm@10.34.8 --activate && pnpm install --frozen-lockfile",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Hack or Treat",
      "onAutoForward": "openPreview",
      "visibility": "private"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "bradlc.vscode-tailwindcss"
      ]
    }
  }
}
